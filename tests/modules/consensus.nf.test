nextflow_process {

    name "Test Process GENERATE_CONSENSUS"
    script "modules/consensus.nf"
    process "GENERATE_CONSENSUS"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = tuple("SRR40299199",
                    file("\$projectDir/results/vcf/SRR40299199.raw.vcf.gz", checkIfExists: true),
                    file("\$projectDir/results/vcf/SRR40299199.raw.vcf.gz.csi", checkIfExists: true)
                )
                input[1] = file("\$projectDir/data/ref/GCF_900205735.1_N16961_v2_genomic.fna", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
