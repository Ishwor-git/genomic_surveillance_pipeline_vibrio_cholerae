nextflow_process {

    name "Test Process TRIM_READS"
    script "modules/trim.nf"
    process "TRIM_READS"

    test("Should run without failures") {

        when {
            process {
                """
                input[0] = tuple("SRR40299199", [
                    file("\$projectDir/data/reads/srr40299199/SRR40299199_1.fastq", checkIfExists: true),
                    file("\$projectDir/data/reads/srr40299199/SRR40299199_2.fastq", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
